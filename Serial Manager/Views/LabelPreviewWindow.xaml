<Window x:Class="SerialManager.Views.LabelPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Etikettenvorschau"
        Height="470"
        Width="700"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition x:Name="colQr" Width="243" />
        </Grid.ColumnDefinitions>

        <!-- Linke Seite -->
        <StackPanel Grid.Row="0"
                    Margin="10,10,10,10">

            <Image x:Name="imgLogo"
                   MaxHeight="50"
                   HorizontalAlignment="Left"
                   Margin="0,0,0,8"
                   Stretch="Uniform"/>

            <TextBlock x:Name="lblCompany"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#1976D2"/>

            <Separator Margin="0,8"/>

            <StackPanel x:Name="panelArticle">
                <TextBlock Text="Artikel"
                       FontWeight="Bold"/>

                <TextBlock x:Name="lblArticle"
                       Margin="0,0,0,8"/>
            </StackPanel>

            <StackPanel x:Name="panelDescription">
                <TextBlock Text="Beschreibung"
                       FontWeight="Bold"/>

                <TextBlock x:Name="lblDescription"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>
            </StackPanel>

            <StackPanel x:Name="panelSerial">
                <TextBlock Text="Seriennummer"
                       FontWeight="Bold"/>

                <Border
                    CornerRadius="5"
                    Padding="8"
                    Margin="0,2,0,8" Background="{DynamicResource PrimaryBrush}">

                    <TextBlock x:Name="lblSerial"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>

                </Border>
            </StackPanel>

            <StackPanel x:Name="panelMachine">
                <TextBlock Text="Maschine"
                       FontWeight="Bold"/>

                <TextBlock x:Name="lblMachine"
                       Margin="0,0,0,8"/>
            </StackPanel>

            <StackPanel x:Name="panelDate">
                <TextBlock Text="Datum"
                       FontWeight="Bold"/>

                <TextBlock x:Name="lblDate"
                       Margin="0,0,0,8"/>
            </StackPanel>

            <StackPanel x:Name="panelOperator">
                <TextBlock Text="Bearbeiter"
                       FontWeight="Bold"/>

                <TextBlock x:Name="lblOperator"/>
            </StackPanel>

        </StackPanel>

        <!-- Rechte Seite -->
        <StackPanel x:Name="panelQr"
                Grid.Row="0"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" Height="178" Width="150">

            <Image x:Name="imgQrCode"
               Width="150"
               Height="150"
               Stretch="Uniform"/>

            <TextBlock Text="QR-Code"
                   Margin="0,10,0,0"
                   HorizontalAlignment="Center"
                   FontWeight="Bold"/>

        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="10,0,10,10">

            <Button Width="120"
                    Content="Drucken"
                    Click="Print_Click" Background="{DynamicResource PrimaryBrush}"/>

            <Button Width="120"
                    Margin="10,0,0,0"
                    Content="Schlie&#223;en"
                    Click="Close_Click" Background="{DynamicResource PrimaryBrush}"/>

        </StackPanel>

    </Grid>
</Window>
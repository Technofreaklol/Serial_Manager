<Window x:Class="SerialManager.Views.LabelPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Etikettenvorschau"
        Height="470"
        Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#DDDDDD">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Zeigt exakt dasselbe Visual, das PrinterService beim
             tatsächlichen Drucken erzeugt (siehe PrinterService.CreateVisual,
             aufgerufen in LabelPreviewWindow.xaml.cs) - nur zusätzlich mit
             einer Viewbox auf Bildschirmgröße skaliert, statt wie bisher eine
             eigene, unabhängige Nachbildung des Layouts zu zeigen. Damit
             stimmt die Vorschau am Bildschirm mit dem späteren Ausdruck
             überein (Größe, Skalierung, Schriftgrößen, Seitenverhältnis,
             Anordnung). -->
        <Border Grid.Row="0"
                Margin="20"
                Background="White"
                BorderBrush="#999999"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Viewbox x:Name="previewViewbox"
                     Stretch="Uniform"
                     MaxWidth="620"
                     MaxHeight="340"/>

        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="10,0,10,10">

            <Button Width="120"
                    Content="Drucken"
                    Click="Print_Click"/>

            <Button Width="120"
                    Margin="10,0,0,0"
                    Content="Schlie&#223;en"
                    Click="Close_Click"/>

        </StackPanel>

    </Grid>
</Window>
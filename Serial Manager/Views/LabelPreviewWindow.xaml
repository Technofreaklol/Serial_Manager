<Window x:Class="SerialManager.Views.LabelPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Etikettenvorschau"
        Height="420"
        Width="700"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="243" />
        </Grid.ColumnDefinitions>

        <!-- Linke Seite -->
        <StackPanel Margin="10,10,10,10">

            <TextBlock x:Name="lblCompany"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#1976D2"/>

            <Separator Margin="0,8"/>

            <TextBlock Text="Artikel"
                   FontWeight="Bold"/>

            <TextBlock x:Name="lblArticle"
                   Margin="0,0,0,8"/>

            <TextBlock Text="Beschreibung"
                   FontWeight="Bold"/>

            <TextBlock x:Name="lblDescription"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>

            <TextBlock Text="Seriennummer"
                   FontWeight="Bold"/>

            <Border Background="#1976D2"
                CornerRadius="5"
                Padding="8"
                Margin="0,2,0,8">

                <TextBlock x:Name="lblSerial"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"/>

            </Border>

            <TextBlock Text="Maschine"
                   FontWeight="Bold"/>

            <TextBlock x:Name="lblMachine"
                   Margin="0,0,0,8"/>

            <TextBlock Text="Datum"
                   FontWeight="Bold"/>

            <TextBlock x:Name="lblDate"/>

        </StackPanel>

        <!-- Rechte Seite -->
        <StackPanel Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" Height="178" Width="150">

            <Image x:Name="imgQrCode"
               Width="150"
               Height="150"
               Stretch="Uniform"/>

            <TextBlock Text="QR-Code"
                   Margin="0,10,0,0"
                   HorizontalAlignment="Center"
                   FontWeight="Bold"/>

        </StackPanel>

    </Grid>
</Window>   
<Window x:Class="SerialManager.Views.AppInfo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Über"
        Height="420"
        Width="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F2F2F2">

    <Border Margin="15"
            Background="White"
            BorderBrush="#D0D0D0"
            BorderThickness="1"
            CornerRadius="8">

        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Kopf -->

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="96"
                        Height="96"
                        CornerRadius="8"
                        Background="#FFFFFF">

                    <Image Source="/Assets/logo.png"
                           Stretch="Uniform"/>
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="Serial Manager"
                               FontSize="26"
                               FontWeight="Bold"/>

                    <TextBlock Text="Seriennummern einfach verwalten"
                               FontSize="15"
                               Foreground="Gray"/>

                    <TextBlock x:Name="txtVersion"
                               Margin="0,12,0,0"
                               FontWeight="Bold"
                               Foreground="#1565C0"/>

                </StackPanel>

            </Grid>

            <!-- Informationen -->

            <Grid Grid.Row="1"
                  Margin="0,30,0,20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Entwickler:"
                           FontWeight="Bold"/>

                <TextBlock Grid.Column="1"
                           Text="Nikolai Hieber"/>

                <TextBlock Grid.Row="1"
                           Margin="0,10,0,0"
                           Text="Framework:"
                           FontWeight="Bold"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Margin="0,10,0,0"
                           Text=".NET 8 • WPF • SQLite • MySQL"/>

                <TextBlock Grid.Row="2"
                           Margin="0,10,0,0"
                           Text="Build:"
                           FontWeight="Bold"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           Margin="0,10,0,0"
                           x:Name="txtBuildDate"/>

                <TextBlock Grid.Row="3"
                           Margin="0,10,0,0"
                           Text="Copyright:"
                           FontWeight="Bold"/>

                <TextBlock Grid.Row="3"
                           Grid.Column="1"
                           Margin="0,10,0,0"
                           Text="© 2026 Nikolai Hieber"/>

            </Grid>

            <!-- Buttons -->

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">


                <Button Width="100"
                        Height="35"
                        Content="OK"
                        Click="Button_Click"/>

            </StackPanel>

        </Grid>

    </Border>

</Window>
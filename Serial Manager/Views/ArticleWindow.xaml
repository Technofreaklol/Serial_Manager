<Window x:Class="SerialManager.Views.ArticleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Artikelverwaltung"
        Height="600"
        Width="800"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Eingabebereich -->
        <GroupBox Header="Artikeldaten" Grid.Row="0">
            <Grid Margin="10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Artikelnummer:"/>

                <TextBox x:Name="txtArticleNumber"
                         Grid.Row="0"
                         Grid.Column="1"
                         Margin="5"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Beschreibung:"/>

                <TextBox x:Name="txtDescription"
                         Grid.Row="1"
                         Grid.Column="1"
                         Margin="5"/>

                

                <StackPanel Grid.Row="2"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0">

                    <Button Content="Speichern"
                            Width="90"
                            Margin="5"
                            Click="Save_Click"/>

                    <Button Content="Löschen"
                            Width="90"
                            Margin="5"
                            Click="Delete_Click"/>
                    
                    <Button Content="Aktivieren/Deaktivieren"
                            Width="180"
                            Margin="5"
                            Click="ToggleActive_Click"/>
                </StackPanel>

            </Grid>
        </GroupBox>

        <!-- Tabelle -->
        <DataGrid x:Name="dgArticles"
                  Grid.Row="2"
                  Margin="0,15,0,0"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="dgArticles_SelectionChanged">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Artikelnummer"
                                    Binding="{Binding ArticleNumber}"
                                    Width="180"/>

                <DataGridTextColumn Header="Beschreibung"
                                    Binding="{Binding Description}"
                                    Width="*"/>

                <DataGridCheckBoxColumn Header="Aktiv"
                                    Binding="{Binding IsActive}"
                                    Width="60"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>

</Window>
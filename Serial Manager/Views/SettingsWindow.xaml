<Window x:Class="SerialManager.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen"
        Height="730"
        Width="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl>

            <!-- ================= Allgemein ================= -->
            <TabItem Header="Allgemein">
                <Grid Margin="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Firmenname:"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="txtCompany"
                             Grid.Column="1"/>

                    <TextBlock Grid.Row="1"
                               Margin="0,15,0,0"
                               Text="Backups behalten:"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="txtBackupCount"
                             Grid.Row="1"
                             Grid.Column="1"
                             Margin="0,15,0,0"/>

                    <CheckBox x:Name="chkAutoBackup"
                              Grid.Row="2"
                              Grid.ColumnSpan="2"
                              Margin="0,20,0,0"
                              Content="Beim Programmstart automatisch Backup erstellen"/>

                    <CheckBox x:Name="chkShowLabelPreview"
                              Grid.Row="3"
                              Grid.ColumnSpan="2"
                              Margin="0,5,0,0"
                              Content="Etikettenvorschau nach dem Erzeugen anzeigen"/>

                </Grid>
            </TabItem>

            <!-- ================= Button-Farbe ================= -->
            <TabItem Header="Button-Farbe">
                <StackPanel Margin="10">

                    <StackPanel Orientation="Horizontal"
                                Margin="0,4">

                        <TextBox x:Name="txtButtonColor"
                                 Width="90"
                                 VerticalAlignment="Center"
                                 TextChanged="txtButtonColor_TextChanged"/>

                        <Border x:Name="borderColorPreview"
                                Width="28"
                                Height="26"
                                Margin="8,0,0,0"
                                BorderThickness="1"
                                BorderBrush="#D9D9D9"/>

                        <Button Width="36"
                                Height="26"
                                Margin="8,0,0,0"
                                Content="..."
                                ToolTip="Farbauswahl öffnen"
                                Click="BtnPickColor_Click"/>

                    </StackPanel>

                    <TextBlock Margin="0,10,0,4"
                               Text="Vorlagen:"/>

                    <StackPanel x:Name="panelColorPresets"
                                Orientation="Horizontal"/>

                </StackPanel>
            </TabItem>

            <!-- ================= Etikett ================= -->
            <TabItem Header="Etikett">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">

                        <GroupBox Header="Angezeigte Felder">
                            <StackPanel>
                                <CheckBox x:Name="chkLabelCompany" Content="Firmenname" Margin="0,3"/>
                                <CheckBox x:Name="chkLabelArticle" Content="Artikelnummer" Margin="0,3"/>
                                <CheckBox x:Name="chkLabelDescription" Content="Beschreibung" Margin="0,3"/>
                                <CheckBox x:Name="chkLabelSerial" Content="Seriennummer" Margin="0,3"/>
                                <CheckBox x:Name="chkLabelMachine" Content="Maschine" Margin="0,3"/>
                                <CheckBox x:Name="chkLabelDate" Content="Datum" Margin="0,3"/>
                                <CheckBox x:Name="chkLabelOperator" Content="Bearbeiter" Margin="0,3"/>
                                <CheckBox x:Name="chkLabelQr" Content="QR-Code" Margin="0,3"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Größe (Etikettendrucker)"
                                  Margin="0,10,0,0">
                            <StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,4">

                                    <TextBlock Text="Breite:"
                                               VerticalAlignment="Center"
                                               Width="55"/>

                                    <TextBox x:Name="txtLabelWidthMm"
                                             Width="60"
                                             VerticalAlignment="Center"/>

                                    <TextBlock Text="mm"
                                               VerticalAlignment="Center"
                                               Margin="4,0,20,0"/>

                                    <TextBlock Text="Höhe:"
                                               VerticalAlignment="Center"
                                               Width="45"/>

                                    <TextBox x:Name="txtLabelHeightMm"
                                             Width="60"
                                             VerticalAlignment="Center"/>

                                    <TextBlock Text="mm"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0"/>

                                </StackPanel>

                                <TextBlock Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Text="Muss zur Etikettenrolle im Etikettendrucker passen (z. B. 60x40mm). Wird beim Drucken als Seitengröße an den Drucker übergeben."/>

                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Firmenlogo"
                                  Margin="0,10,0,0">
                            <StackPanel>

                                <StackPanel Orientation="Horizontal">

                                    <Border Width="120"
                                            Height="50"
                                            BorderThickness="1"
                                            BorderBrush="#D9D9D9">
                                        <Image x:Name="imgLogoPreview"
                                               Stretch="Uniform"
                                               Margin="2"/>
                                    </Border>

                                    <StackPanel Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                        <Button Content="Logo wählen..."
                                                Width="140"
                                                Click="BtnChooseLogo_Click"/>
                                        <Button Content="Logo entfernen"
                                                Width="140"
                                                Click="BtnRemoveLogo_Click"/>
                                    </StackPanel>

                                </StackPanel>

                                <TextBlock Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           Text="Das Logo gilt für alle Benutzer dieser Datenbank und erscheint oben links auf dem Etikett."/>

                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Width="120"
                    Content="Speichern"
                    Click="Save_Click"/>

            <Button Width="120"
                    Margin="10,0,0,0"
                    Content="Abbrechen"
                    Click="Cancel_Click"/>

        </StackPanel>

    </Grid>

</Window>
<Window x:Class="SerialManager.Views.DatabaseSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Datenbank"
        Height="750"
        Width="700"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Datenbanktyp -->

        <StackPanel>

            <TextBlock Text="Datenbanktyp"
                       FontWeight="Bold"/>

            <ComboBox x:Name="cmbProvider"
                      Width="180"
                      Margin="0,5,0,15"
                      HorizontalAlignment="Left"
                      SelectionChanged="cmbProvider_SelectionChanged">

                <ComboBoxItem Content="SQLite"/>
                <ComboBoxItem Content="MySQL"/>

            </ComboBox>

        </StackPanel>

        <!-- Verbindung -->

        <Grid Grid.Row="1">

            <!-- SQLite -->

            <GroupBox x:Name="grpSQLite"
                      Header="SQLite">

                <Grid Margin="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Datei:"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="txtSQLiteFile"
                             Grid.Column="1"
                             Margin="10,0"/>

                    <Button Grid.Column="2"
                            Width="110"
                            Margin="10,0,0,0"
                            Content="Durchsuchen..."
                            Click="BrowseSQLite_Click"/>

                </Grid>

            </GroupBox>

            <!-- MySQL -->

            <GroupBox x:Name="grpMySql"
                      Header="MySQL">

                <Grid Margin="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Server"
                               VerticalAlignment="Center"/>

                    <TextBox x:Name="txtServer"
                             Grid.Column="1" Margin="0,4,0,4"/>

                    <TextBlock Grid.Row="1"
                               Margin="0,10,0,0"
                               Text="Port"/>

                    <TextBox x:Name="txtPort"
                             Grid.Row="1"
                             Grid.Column="1"
                             Margin="0,10,0,0"/>

                    <TextBlock Grid.Row="2"
                               Margin="0,10,0,0"
                               Text="Datenbank"/>

                    <TextBox x:Name="txtDatabase"
                             Grid.Row="2"
                             Grid.Column="1"
                             Margin="0,10,0,0"/>

                    <TextBlock Grid.Row="3"
                               Margin="0,10,0,0"
                               Text="Benutzer"/>

                    <TextBox x:Name="txtUser"
                             Grid.Row="3"
                             Grid.Column="1"
                             Margin="0,10,0,0"/>

                    <TextBlock Grid.Row="4"
                               Margin="0,14,0,-4"
                               Text="Passwort"/>

                    <PasswordBox x:Name="txtPassword"
                                 Grid.Row="4"
                                 Grid.Column="1"
                                 Margin="0,10,0,0" Height="30"/>

                </Grid>

            </GroupBox>

        </Grid>

        <!-- Aktionen -->

        <GroupBox Grid.Row="2"
          Margin="0,15,0,0"
          Header="Aktionen">

            <StackPanel Orientation="Horizontal"
                Margin="10">

                <Button Width="180"
                Height="35"
                Margin="0,0,10,0"
                Content="Initialisieren"
                Click="Initialize_Click"/>

                <Button Width="180"
                Height="35"
                Margin="0,0,10,0"
                Content="Status aktualisieren"
                Click="RefreshStatus_Click"/>

                <Button Width="180"
                Height="35"
                Content="Datenbank reparieren"
                Click="RepairDatabase_Click"/>

            </StackPanel>

        </GroupBox>

        <!-- Status -->

        <GroupBox Grid.Row="3"
                  Margin="0,15,0,0"
                  Header="Status">

            <TextBox x:Name="txtStatus"
                     Margin="10,0,10,0"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Height="NaN"/>

        </GroupBox>

        <!-- Buttons -->

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Width="150"
                    Content="Diagnose kopieren"
                    Click="CopyDiagnostic_Click"/>

            <Button Width="120"
                    Margin="10,0,0,0"
                    Content="Speichern"
                    Click="Save_Click"/>

            <Button Width="120"
                    Margin="10,0,0,0"
                    Content="Schließen"
                    Click="Close_Click"/>

        </StackPanel>

    </Grid>

</Window>
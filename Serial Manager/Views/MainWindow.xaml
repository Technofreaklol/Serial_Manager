<Window x:Class="SerialManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stewe Seriennummer Verwaltung"
        Height="760"
        Width="1200"
        MinHeight="760"
        MinWidth="950"
        WindowStartupLocation="CenterScreen" >

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menü -->
        <Menu Grid.Row="0">
            <MenuItem Header="_Datei">
                <MenuItem Header="Abmelden"
                  Click="MenuLogout_Click"/>

                <Separator x:Name="sepDateiTop"/>

                <MenuItem x:Name="miBackup" Header="Backup erstellen..."
                  Click="MenuBackup_Click"/>
                <MenuItem x:Name="miRestore" Header="Backup wiederherstellen..."
                  Click="MenuRestore_Click"/>

                <Separator x:Name="sepDateiBottom"/>
                <MenuItem Header="Beenden"
                  Click="MenuExit_Click"/>
            </MenuItem>

            <MenuItem Header="_Stammdaten">
                <MenuItem Header="Artikel verwalten"
                          Click="MenuArticles_Click"/>
                <MenuItem x:Name="miMachines" Header="Maschinen verwalten"
                          Click="MenuMachines_Click"/>
            </MenuItem>

            <MenuItem Header="_Seriennummern">
                <MenuItem x:Name="miResetSerial" Header="Seriennummer anpassen"
Click="MenuResetSerial_Click"/>
                <Separator x:Name="sepSerienTop"/>
                <MenuItem Header="Batch-Seriennummern..."
              Click="BatchSerial_Click"/>
                <Separator/>
                <MenuItem Header="Historie exportieren..."
                  Click="MenuExport_Click"/>
            </MenuItem>

            <MenuItem Header="_Extras">
                <MenuItem Header="Passwort ändern..."
                          Click="MenuChangePassword_Click"/>

                <Separator x:Name="sepExtrasTop"/>

                <MenuItem x:Name="miSettings" Header="Einstellungen..."
              Click="Settings_Click"/>

                <Separator x:Name="sepExtrasMid"/>

                <MenuItem x:Name="miDatabase" Header="Datenbank..."
              Click="Database_Click"/>

                <MenuItem x:Name="miMigrationAssistant" Header="Datenbank-Migration..."
                          Click="MenuMigrationAssistant_Click"/>

                <MenuItem x:Name="miUsers" Header="Benutzer verwalten..."
                          Click="MenuUsers_Click"/>

                <MenuItem x:Name="miAuditLog" Header="Audit-Log..."
                          Click="MenuAuditLog_Click"/>
            </MenuItem>

            <MenuItem Header="_Hilfe">
                <MenuItem Header="Nach Updates suchen..."
                          Click="MenuCheckForUpdates_Click"/>
                <Separator/>
                <MenuItem Header="Über"
                          Click="MenuAbout_Click"/>
            </MenuItem>

        </Menu>

        <!-- Toolbar -->
        <Border Grid.Row="1"
                Background="#F0F0F0"
                BorderBrush="#D0D0D0"
                BorderThickness="0,0,0,1"
                Padding="4">
            <DockPanel LastChildFill="False">

                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Left">

                    <Button Content="Artikel"
                            Click="MenuArticles_Click"/>

                    <Button x:Name="btnMachinesToolbar" Content="Maschinen"
                            Click="MenuMachines_Click"/>

                    <Separator/>

                    <Button Content="Aktualisieren"
                            Click="Refresh_Click"/>

                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right"
                            VerticalAlignment="Center">

                    <TextBlock Text="Seriennummer scannen:"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>

                    <TextBox x:Name="txtScan"
                             Width="260"
                             VerticalAlignment="Center"
                             ToolTip="QR-Code eines Etiketts scannen oder Seriennummer eintippen und Enter drücken"
                             KeyDown="txtScan_KeyDown"/>

                </StackPanel>

            </DockPanel>
        </Border>

        <!-- Hauptbereich -->
        <Grid Grid.Row="2" Margin="20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
        Grid.ColumnSpan="3"
        Margin="0,0,0,15"
        Padding="10"
        Background="#F5F5F5"
        BorderBrush="#DDDDDD"
        BorderThickness="1"
        CornerRadius="5">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
               Text="Seriennummer Verwaltung"
               FontSize="24"
               FontWeight="Bold"
               VerticalAlignment="Center"/>

                    <Border Grid.Column="1"
            Margin="5"
            Padding="10"
            Background="#cccccc"
            CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="Artikel"
                       FontWeight="Bold"/>
                            <TextBlock x:Name="lblArticleCount"
                       FontSize="22"
                       FontWeight="Bold"
                       Text="0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
            Margin="5"
            Padding="10"
            Background="#cccccc"
            CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="Maschinen"
                       FontWeight="Bold"/>
                            <TextBlock x:Name="lblMachineCount"
                       FontSize="22"
                       FontWeight="Bold"
                       Text="0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3"
            Margin="5"
            Padding="10"
            Background="#cccccc"
            CornerRadius="5">
                        <StackPanel>
                            <TextBlock Text="Heute erzeugt"
                       FontWeight="Bold"/>
                            <TextBlock x:Name="lblTodayCount"
                       FontSize="22"
                       FontWeight="Bold"
                       Text="0"/>
                        </StackPanel>
                    </Border>

                </Grid>

            </Border>


            <!-- Linke Seite -->


            <Border Grid.Row="1"
                    Grid.Column="0"
                    Padding="15"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    CornerRadius="5">

                <StackPanel>

                    <TextBlock Text="Kunde"
                               FontWeight="Bold"/>

                    <ComboBox x:Name="cmbCustomer"
                              Height="30"
                              Margin="0,5,0,15"
                              MaxDropDownHeight="240"
                              SelectionChanged="cmbCustomer_SelectionChanged"/>

                    <TextBlock Text="Artikel"
                               FontWeight="Bold"/>

                    <ComboBox x:Name="cmbArticles"
                              Height="30"
                              Margin="0,5,0,15"
                              IsEditable="True"
                              IsTextSearchEnabled="False"
                              StaysOpenOnEdit="True"
                              MaxDropDownHeight="240"
                              VirtualizingPanel.IsVirtualizing="False"
                              TextSearch.TextPath="ArticleNumber"
                              TextBoxBase.TextChanged="cmbArticles_TextChanged"
                              SelectionChanged="cmbArticles_SelectionChanged">

                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding ArticleNumber}"/>
                                    <Run Text=" - "/>
                                    <Run Text="{Binding Description}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>

                    </ComboBox>

                    <TextBlock Text="Maschine"
                               FontWeight="Bold"/>

                    <ComboBox x:Name="cmbMachines"
                              Height="30"
                              Margin="0,5,0,15"
                              MaxDropDownHeight="240"
                              DisplayMemberPath="Name"/>

                    <TextBlock Text="Beschreibung"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="lblDescription"
                               Margin="0,5,0,15"
                               FontSize="16"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="letzte Seriennummer"
                               FontWeight="Bold"/>

                    <Border Background="#263238"
        CornerRadius="15"
        Padding="15"
        Margin="0,5,0,20">

                        <TextBlock x:Name="lblCurrentSerial"
               FontSize="40"
               FontWeight="Bold"
               Foreground="White"
               HorizontalAlignment="Center"/>

                    </Border>

                    <Button x:Name="btnGenerate"
        Height="55"
        FontSize="18"
        FontWeight="Bold"
        Content="Seriennummer erzeugen"

        Click="btnGenerate_Click"/>

                </StackPanel>

            </Border>
            <!-- Rechte Seite -->
            <GroupBox Grid.Row="1"
                      Grid.Column="2"
                      Header="Historie">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="txtSearch"
                             Margin="5"
                             Height="30"
                             VerticalContentAlignment="Center"
                             TextChanged="txtSearch_TextChanged"
                             ToolTip="Suche nach Seriennummer oder Maschine"/>

                    <DataGrid x:Name="dgHistory"
          Grid.Row="1"
          Margin="5"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          MouseDoubleClick="dgHistory_MouseDoubleClick">

                        <DataGrid.ContextMenu>

                            <ContextMenu>

                                <MenuItem Header="Etikett anzeigen"
                      Click="MenuPreviewLabel_Click"/>

                                <MenuItem Header="Etikett drucken"
                      Click="MenuPrintLabel_Click"/>

                                <Separator/>

                                <MenuItem Header="Seriennummer kopieren"
                      Click="MenuCopySerial_Click"/>

                                <MenuItem Header="Details"
                      Click="MenuDetails_Click"/>

                                <Separator/>

                                <MenuItem Header="Seriennummer löschen..."
                      Click="MenuDeleteSerial_Click"/>

                            </ContextMenu>

                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="SN"
                                                Binding="{Binding SerialNumber}"
                                                Width="80"/>

                            <DataGridTextColumn Header="Datum"
                                                Binding="{Binding Created, StringFormat=dd.MM.yyyy HH:mm}"
                                                Width="170"/>

                            <DataGridTextColumn Header="Maschine"
                                                Binding="{Binding Machine}"
                                                Width="150"/>

                            <DataGridTextColumn Header="Erstellt von"
                                                Binding="{Binding Operator}"
                                                Width="140"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </GroupBox>

        </Grid>

        <!-- Statusleiste -->
        <StatusBar Grid.Row="3">
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="lblCurrentUser"/>
            </StatusBarItem>

            <StatusBarItem>
                <TextBlock x:Name="lblStatus"
                           Text="Bereit"/>
            </StatusBarItem>

            <Separator/>

            <StatusBarItem>
                <TextBlock Text="{Binding SelectedItem.ArticleNumber,
                                          ElementName=cmbArticles,
                                          FallbackValue='Kein Artikel'}"/>
            </StatusBarItem>

            <Separator/>

            <StatusBarItem>
                <TextBlock Text="{Binding SelectedItem.Name,
                                          ElementName=cmbMachines,
                                          FallbackValue='Keine Maschine'}"/>
            </StatusBarItem>

        </StatusBar>

    </Grid>



</Window>
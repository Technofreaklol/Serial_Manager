<Window x:Class="SerialManager.Views.MigrationAssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Datenbank-Migrationsassistent" Height="380" Width="500"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="lblStatus" Grid.Row="0"
                   TextWrapping="Wrap" VerticalAlignment="Top"/>

        <StackPanel x:Name="progressPanel" Grid.Row="1"
                    Margin="0,10,0,0" Visibility="Collapsed">
            <ProgressBar x:Name="progressBar" Height="20" Minimum="0" Maximum="100"/>
            <TextBlock x:Name="txtProgressStatus" Margin="0,5,0,0" FontSize="11" Foreground="Gray"/>
        </StackPanel>

        <Button x:Name="btnRun" Grid.Row="2"
                Content="Backup erstellen &amp; aktualisieren"
                Height="35" Margin="0,15,0,0"
                Click="Run_Click"/>
    </Grid>
</Window>
<Window x:Class="SerialManager.Views.AuditLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audit-Log" Height="500" Width="750"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="dgAudit" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Datum/Zeit"
                                     Binding="{Binding Created, StringFormat=dd.MM.yyyy HH:mm:ss}"
                                     Width="150"/>
                <DataGridTextColumn Header="Benutzer" Binding="{Binding Username}" Width="140"/>
                <DataGridTextColumn Header="Aktion" Binding="{Binding Action}" Width="200"/>
                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="1" Content="Aktualisieren" Width="120" Height="32"
                HorizontalAlignment="Right" Margin="0,10,0,0" Click="Refresh_Click"/>
    </Grid>
</Window>
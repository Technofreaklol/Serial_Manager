<Window x:Class="SerialManager.Views.ResetSerialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seriennummer zurücksetzen"
        Height="370"
        Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Kunde:"
                   VerticalAlignment="Center"/>

        <ComboBox x:Name="cmbCustomer"
                  Grid.Column="1"
                  MaxDropDownHeight="240"
                  SelectionChanged="cmbCustomer_SelectionChanged" Margin="0,4,0,4"/>

        <TextBlock Grid.Row="1"
                   Text="Artikel:"
                   Margin="0,10,0,0"
                   VerticalAlignment="Center"/>

        <ComboBox x:Name="cmbArticles"
                  Grid.Row="1"
                  Grid.Column="1"
                  Margin="0,10,0,0"
                  MaxDropDownHeight="240"
                  DisplayMemberPath="ArticleNumber"
                  SelectionChanged="cmbArticles_SelectionChanged"/>

        <TextBlock Grid.Row="2"
                   Margin="0,15,0,0"
                   Text="Aktuelle Seriennummer:"
                   VerticalAlignment="Center"/>

        <TextBlock x:Name="lblCurrentSerial"
                   Grid.Row="2"
                   Grid.Column="1"
                   Margin="5,15,0,0"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="DarkBlue"/>

        <TextBlock Grid.Row="3"
                   Margin="0,15,0,0"
                   Text="Neue Seriennummer:"
                   VerticalAlignment="Center"/>

        <TextBox x:Name="txtNewSerial"
                 Grid.Row="3"
                 Grid.Column="1"
                 Margin="0,15,0,0"/>

        <TextBlock Grid.Row="4"
                   Margin="0,15,0,0"
                   Text="Grund (optional):"
                   VerticalAlignment="Top"/>

        <TextBox x:Name="txtReason"
                 Grid.Row="4"
                 Grid.Column="1"
                 Margin="0,15,0,0"
                 Height="60"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"/>

        <StackPanel Grid.Row="6"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Width="110"
                    Content="Speichern"
                    Click="Save_Click"/>

            <Button Width="110"
                    Margin="10,0,0,0"
                    Content="Abbrechen"
                    Click="Cancel_Click"/>

        </StackPanel>

    </Grid>

</Window>
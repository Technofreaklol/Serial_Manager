<Window x:Class="SerialManager.Views.HistoryDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seriennummer-Details"
        Height="230"
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Artikelnummer:"
                   FontWeight="Bold"/>

        <TextBlock Grid.Row="0"
                   Grid.Column="1"
                   x:Name="lblArticle"/>

        <TextBlock Grid.Row="1"
                   Text="Seriennummer:"
                   FontWeight="Bold"/>

        <TextBlock Grid.Row="1"
                   Grid.Column="1"
                   x:Name="lblSerial"
                   FontSize="12"
                   FontWeight="Bold"/>

        <TextBlock Grid.Row="2"
                   Text="Maschine:"
                   FontWeight="Bold"/>

        <TextBlock Grid.Row="2"
                   Grid.Column="1"
                   x:Name="lblMachine"/>

        <TextBlock Grid.Row="3"
                   Text="Erstellt am:"
                   FontWeight="Bold"/>

        <TextBlock Grid.Row="3"
                   Grid.Column="1"
                   x:Name="lblCreated"/>

        <TextBlock Grid.Row="4"
                   Text="Erstellt von:"
                   FontWeight="Bold"/>

        <TextBlock Grid.Row="4"
                   Grid.Column="1"
                   x:Name="lblCreatedBy"/>

        <Button Grid.Row="5"
                Grid.ColumnSpan="2"
                Width="120"
                Height="35"
                HorizontalAlignment="Center"
                Margin="0,20,0,0"
                Content="Schlie&#223;en"
                Click="Close_Click"/>

    </Grid>

</Window>
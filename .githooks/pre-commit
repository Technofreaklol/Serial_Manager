#!/bin/sh
#
# Erhöht automatisch die Patch-Version (letzte Zahl) in der .csproj vor jedem
# Commit, z. B. 1.0.9 -> 1.0.10. Die geänderte .csproj wird automatisch zum
# Commit hinzugefügt, ein manueller Schritt ist nicht nötig.
#
# Der Begleit-Hook .githooks/post-commit setzt direkt danach automatisch
# einen passenden Git-Tag (z. B. v1.0.10) auf den neuen Commit.
#
# Aktivierung (einmalig pro Klon des Repos):
#   git config core.hooksPath .githooks
#
# Deaktivieren:
#   git config --unset core.hooksPath

CSPROJ="Serial Manager/Serial Manager.csproj"

if [ ! -f "$CSPROJ" ]; then
    echo "pre-commit: '$CSPROJ' nicht gefunden - Version wird nicht erhöht."
    exit 0
fi

CURRENT=$(grep -oE '<Version>[0-9]+\.[0-9]+\.[0-9]+</Version>' "$CSPROJ" | head -n 1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+')

if [ -z "$CURRENT" ]; then
    echo "pre-commit: Keine <Version>x.y.z</Version>-Zeile in '$CSPROJ' gefunden - überspringe."
    exit 0
fi

MAJOR=$(echo "$CURRENT" | cut -d. -f1)
MINOR=$(echo "$CURRENT" | cut -d. -f2)
PATCH=$(echo "$CURRENT" | cut -d. -f3)

NEW_PATCH=$((PATCH + 1))
NEW_VERSION="$MAJOR.$MINOR.$NEW_PATCH"

# sed -i.bak funktioniert sowohl mit GNU sed (Linux/Git-Bash) als auch mit
# BSD/macOS sed identisch; die Sicherungsdatei wird danach entfernt.
sed -i.bak "s#<Version>$CURRENT</Version>#<Version>$NEW_VERSION</Version>#" "$CSPROJ"
rm -f "$CSPROJ.bak"

git add "$CSPROJ"

echo "pre-commit: Version automatisch erhöht: $CURRENT -> $NEW_VERSION"

exit 0
